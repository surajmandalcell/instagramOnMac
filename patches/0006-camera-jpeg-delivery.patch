+    /** A configured output receives bytes only when this request targets its Surface. */
+    static List<Surface> dispatchImageReaders(CaptureRequest request, List<ImageReader> readers) {
+        List<Surface> lost = new ArrayList<>();
+        if (request == null) return lost;
+        List<Surface> targets = request.getTargets();
+        Byte quality = request.get(CaptureRequest.JPEG_QUALITY);
+        Integer orientation = request.get(CaptureRequest.JPEG_ORIENTATION);
