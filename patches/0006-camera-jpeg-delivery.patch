+            Surface surface = reader.getSurface();
+            if (!targets.contains(surface)) continue;
+            if (reader.getImageFormat() == ImageFormat.JPEG) {
+                if (!reader.macapkOnCameraFrame(quality == null ? 90 : quality & 0xff,
+                        orientation == null ? 0 : orientation)) lost.add(surface);
+            } else reader.macapkOnCameraFrame();
+        }
+        return lost;
+    }
