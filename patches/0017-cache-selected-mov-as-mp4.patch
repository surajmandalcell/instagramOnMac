+package com.macapk.loader;
+
+import android.content.Context;
+import android.net.Uri;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.Locale;
+import java.util.concurrent.*;
+
+/** One derived MP4 per explicitly selected source revision. Originals are read only. */
+public final class MovCompatibilityCache {
+    public enum State { WAITING, RUNNING, READY, FAILED }
+    public record Snapshot(State state, double fraction, String error) {}
+    private static final ConcurrentHashMap<String, Job> JOBS = new ConcurrentHashMap<>();
+    private static final ConcurrentHashMap<String, Job> ALIASES = new ConcurrentHashMap<>();
+    private static final ConcurrentHashMap<String, Job> URIS = new ConcurrentHashMap<>();
+    private static final ExecutorService WORKER = new ThreadPoolExecutor(1, 1, 0L,
+            TimeUnit.SECONDS, new ArrayBlockingQueue<>(16), task -> {
+                Thread thread = new Thread(task, "macapk-mov-conversion");
+                thread.setDaemon(true); return thread;
+            });
+    private static final class Job {
+        volatile Snapshot snapshot = new Snapshot(State.WAITING, 0, null);
+        final CompletableFuture<File> future = new CompletableFuture<>();
+    }
+    private MovCompatibilityCache() {}
+    public static boolean needsConversion(File file) {
+        return file != null && file.getName().toLowerCase(Locale.ROOT).endsWith(".mov");
+    }
+    public static Snapshot snapshotForSelectedData(String alias) {
+        Job job = alias == null ? null : ALIASES.get(alias); return job == null ? null : job.snapshot;
+    }
+    public static Snapshot snapshotForSelectedUri(Uri uri) {
+        Job job = uri == null ? null : URIS.get(uri.toString()); return job == null ? null : job.snapshot;
+    }
+    public static boolean sameSelectedSource(String first, String second) {
+        if (first == null || second == null) return false;
+        if (first.equals(second)) return true;
+        Job job = ALIASES.get(first); return job != null && job == ALIASES.get(second);
+    }
+    public static String readyAliasForSelectedData(String alias) {
+        Job job = alias == null ? null : ALIASES.get(alias);
+        if (job == null || job.snapshot.state() != State.READY) return alias;
+        File output = job.future.getNow(null);
+        if (output == null || !output.isFile() || output.length() == 0) return alias;
+        String derived = DocumentPickerHandler.macapkReadOnlySelectedMedia(output.getPath());
+        if (derived == null) return alias;
+        ALIASES.put(derived, job); return derived;
+    }
+    public static void bindUri(Uri uri, String alias) {
+        Job job = ALIASES.get(alias); if (uri != null && job != null) URIS.put(uri.toString(), job);
+    }
+    public static void bindAlias(String originalAlias, String derivedAlias) {
+        Job job = ALIASES.get(originalAlias); if (job != null && derivedAlias != null) ALIASES.put(derivedAlias, job);
+    }
+    public static CompletableFuture<File> prepare(Context context, File original, String alias) throws IOException {
+        if (!needsConversion(original)) return CompletableFuture.completedFuture(original);
+        File canonical = original.getCanonicalFile();
+        BasicFileAttributes stat = Files.readAttributes(canonical.toPath(), BasicFileAttributes.class);
+        String identity = "mp4-v1\n" + (stat.fileKey() == null ? canonical.getPath() : stat.fileKey())
+                + "\n" + stat.size() + "\n" + stat.lastModifiedTime();
+        final String key;
+        try { key = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(identity.getBytes(StandardCharsets.UTF_8))); }
+        catch (java.security.NoSuchAlgorithmException unavailable) { throw new IOException(unavailable); }
+        Job fresh = new Job(); Job prior = JOBS.putIfAbsent(key, fresh); Job job = prior == null ? fresh : prior;
+        if (alias != null) ALIASES.put(alias, job);
+        if (prior != null) {
+            if (job.snapshot.state() == State.READY) {
+                File cached = job.future.getNow(null);
+                if (cached == null || !cached.isFile() || cached.length() == 0
+                        || DocumentPickerHandler.macapkReadVideoMetadata(cached.getPath()) == null) {
+                    JOBS.remove(key, job); return prepare(context, original, alias);
+                }
+            }
+            return job.future;
+        }
+        File directory = new File(context.getCacheDir(), "selected-mp4-v1");
+        try { WORKER.execute(() -> convert(job, canonical, alias, directory, key, stat)); }
+        catch (RejectedExecutionException busy) {
+            job.snapshot = new Snapshot(State.FAILED, 0, "Too many videos are preparing. Try again.");
+            job.future.completeExceptionally(new IOException(job.snapshot.error())); JOBS.remove(key, job);
+        }
+        return job.future;
+    }
+    private static void ownerOnly(java.nio.file.Path path, boolean directory) throws IOException {
+        if (Files.getFileStore(path).supportsFileAttributeView("posix"))
+            Files.setPosixFilePermissions(path, java.nio.file.attribute.PosixFilePermissions.fromString(directory ? "rwx------" : "rw-------"));
+    }
+    private static void convert(Job job, File original, String alias, File directory, String key, BasicFileAttributes before) {
+        File output = new File(directory, key + ".mp4"), part = new File(directory, key + ".part.mp4");
+        try {
+            Files.createDirectories(directory.toPath());
+            ownerOnly(directory.toPath(), true);
+            job.snapshot = new Snapshot(State.RUNNING, 0, null);
+            if (!output.isFile() || output.length() == 0 || DocumentPickerHandler.macapkReadVideoMetadata(output.getPath()) == null) {
+                Files.deleteIfExists(part.toPath());
+                String error = DocumentPickerHandler.macapkConvertMov(alias, part.getPath(), fraction ->
+                        job.snapshot = new Snapshot(State.RUNNING, Math.max(0, Math.min(1, fraction)), null));
+                if (error != null) throw new IOException(error);
+                BasicFileAttributes after = Files.readAttributes(original.toPath(), BasicFileAttributes.class);
+                if (!java.util.Objects.equals(before.fileKey(), after.fileKey()) || before.size() != after.size()
+                        || !before.lastModifiedTime().equals(after.lastModifiedTime())) throw new IOException("The selected file changed. Choose it again.");
+                if (DocumentPickerHandler.macapkReadVideoMetadata(part.getPath()) == null) throw new IOException("Converted video could not be read.");
+                ownerOnly(part.toPath(), false);
+                Files.move(part.toPath(), output.toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+            }
+            ownerOnly(output.toPath(), false);
+            job.snapshot = new Snapshot(State.READY, 1, null); job.future.complete(output);
+        } catch (Throwable failure) {
+            try { Files.deleteIfExists(part.toPath()); } catch (IOException ignored) {}
+            job.snapshot = new Snapshot(State.FAILED, 0, "Video conversion failed. Choose the file again.");
+            job.future.completeExceptionally(new IOException(job.snapshot.error(), failure)); JOBS.remove(key, job);
+        }
+    }
+}
