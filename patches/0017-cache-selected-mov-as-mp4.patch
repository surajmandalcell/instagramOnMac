+// Host-side derivation only; the selected source is never opened for writing.
+static jstring nativeConvertMov(JNIEnv* env, jclass, jstring source, jstring destination, jobject progress) {
+    @autoreleasepool {
+        NSString* path=mediaReadPath(jstr(env,source));
+        NSString* output=jstr(env,destination);
+        if(!path.length || !output.length)return env->NewStringUTF("Selected video is unavailable.");
+        AVURLAsset* asset=[AVURLAsset URLAssetWithURL:[NSURL fileURLWithPath:path] options:nil];
+        NSURL* url=[NSURL fileURLWithPath:output];
+        jclass consumer=progress?env->GetObjectClass(progress):nullptr;
+        jmethodID accept=consumer?env->GetMethodID(consumer,"accept","(D)V"):nullptr;
+        bool success=false;
+        double duration=CMTimeGetSeconds(asset.duration);
+        double budget=std::isfinite(duration)?std::max(120.0,std::min(600.0,duration*2.0+30.0)):120.0;
+        double deadline=CFAbsoluteTimeGetCurrent()+budget;
+        for(NSString* preset in @[AVAssetExportPresetPassthrough,AVAssetExportPresetHighestQuality]) {
+            if(CFAbsoluteTimeGetCurrent()>=deadline)break;
+            [[NSFileManager defaultManager] removeItemAtURL:url error:nil];
+            AVAssetExportSession* session=[[AVAssetExportSession alloc] initWithAsset:asset presetName:preset];
+            if(!session || ![session.supportedFileTypes containsObject:AVFileTypeMPEG4])continue;
+            session.outputURL=url;session.outputFileType=AVFileTypeMPEG4;session.shouldOptimizeForNetworkUse=YES;
+            dispatch_semaphore_t done=dispatch_semaphore_create(0);
+            [session exportAsynchronouslyWithCompletionHandler:^{dispatch_semaphore_signal(done);}];
+            bool timedOut=false;
+            while(dispatch_semaphore_wait(done,dispatch_time(DISPATCH_TIME_NOW,100*NSEC_PER_MSEC))!=0) {
+                if(accept){env->CallVoidMethod(progress,accept,(jdouble)session.progress);if(env->ExceptionCheck())env->ExceptionClear();}
+                if(CFAbsoluteTimeGetCurrent()>deadline){
+                    timedOut=true;[session cancelExport];
+                    dispatch_semaphore_wait(done,dispatch_time(DISPATCH_TIME_NOW,5*NSEC_PER_SEC));break;
+                }
+            }
+            success=session.status==AVAssetExportSessionStatusCompleted;
+            if(success||timedOut)break;
+        }
+        if(!success){if(consumer)env->DeleteLocalRef(consumer);[[NSFileManager defaultManager] removeItemAtURL:url error:nil];return env->NewStringUTF("Video conversion failed.");}
+        if(accept){env->CallVoidMethod(progress,accept,(jdouble)1);if(env->ExceptionCheck())env->ExceptionClear();}
+        if(consumer)env->DeleteLocalRef(consumer);
+        return nullptr;
+    }
+}
