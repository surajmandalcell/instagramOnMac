+/** Keep the host library name while exposing libraries extracted after startup. */
+public final class NativeLibraryNames {
+    private NativeLibraryNames() {}
+    private static final StackWalker CALLER = StackWalker.getInstance(StackWalker.Option.RETAIN_CLASS_REFERENCE);
+    public static String mapLibraryName(String name) {
+        String mapped = System.mapLibraryName(name);
+        ClassLoader loader = CALLER.getCallerClass().getClassLoader();
+        if (loader instanceof AppClassLoader app) app.prepareDownloadedModuleLibrary(name);
+        return mapped;
+    }
+}
