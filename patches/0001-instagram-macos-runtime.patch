+package com.macapk.loader;
+
+/** Local display preferences for the known Instagram account chooser. */
+public final class InstagramAccountSwitcherCompat {
+    private InstagramAccountSwitcherCompat() {}
+
+    public static void apply(android.widget.ListView view, android.widget.ListAdapter adapter) {
+        if (adapter == null || !"X.654".equals(adapter.getClass().getName())) return;
+        try {
+            android.content.Context context = view.getContext();
+            if (context == null) return;
+            String name = context.getPackageName();
+            String version = context.getPackageManager().getPackageInfo(name, 0).versionName;
+            if (!matches(name, version)) return;
+            java.io.File files = context.getFilesDir();
+            if (files != null) filter(adapter, new java.io.File(files,
+                    "macapk/hidden-switcher-user-ids").toPath());
+        } catch (ReflectiveOperationException | java.io.IOException | RuntimeException
+                | android.content.pm.PackageManager.NameNotFoundException ignored) {
+            // Unknown layouts and absent preferences preserve the app's list.
+        }
+    }
+
+    static boolean matches(String name, String version) {
+        return "com.instagram.android".equals(name) && "445.0.0.45.83".equals(version);
+    }
+
+    public static java.util.List<?> foaState(Object owner) { return foa(owner, "X.G6s", "A02"); }
+    public static java.util.List<?> foaD(Object owner) { return foa(owner, "X.G9g", "A0D"); }
+    public static java.util.List<?> foaE(Object owner) { return foa(owner, "X.G9g", "A0E"); }
+    public static java.util.List<?> foaF(Object owner) { return foa(owner, "X.G9g", "A0F"); }
+    public static java.util.List<?> foaG(Object owner) { return foa(owner, "X.G9g", "A0G"); }
+
+    private static java.util.List<?> foa(Object owner, String type, String field) {
+        java.util.List<?> original = null;
+        try {
+            if (owner == null || !owner.getClass().getName().equals(type)) return null;
+            original = (java.util.List<?>) owner.getClass().getField(field).get(owner);
+            android.content.Context context = android.app.ActivityThread.currentApplication();
+            if (context == null || !matches(context.getPackageName(), context.getPackageManager()
+                    .getPackageInfo(context.getPackageName(), 0).versionName)) return original;
+            return filterFoa(original, new java.io.File(context.getFilesDir(),
+                    "macapk/hidden-switcher-user-ids").toPath());
+        } catch (ReflectiveOperationException | java.io.IOException | RuntimeException
+                | android.content.pm.PackageManager.NameNotFoundException ignored) { return original; }
+    }
+
+    static java.util.List<?> filterFoa(java.util.List<?> original, java.nio.file.Path preference)
+            throws ReflectiveOperationException, java.io.IOException {
+        if (original == null || original.isEmpty() || !java.nio.file.Files.isRegularFile(preference)) return original;
+        java.util.Set<String> hidden = hiddenIds(preference);
+        if (hidden.isEmpty()) return original;
+        java.util.List<Object> visible = new java.util.ArrayList<>(original.size());
+        for (Object model : original) {
+            if (model == null || !model.getClass().getName().equals(
+                    "libraries.foa.products.accountswitcher.model.UserAccountInfo")) return original;
+            Object id = model.getClass().getField("A0I").get(model);
+            if (!(id instanceof String) || !hidden.contains(id)) visible.add(model);
+        }
+        return visible.size() == original.size() ? original : visible;
+    }
+
+    private static java.util.Set<String> hiddenIds(java.nio.file.Path preference) throws java.io.IOException {
+        byte[] bytes;
+        try (var input = java.nio.file.Files.newInputStream(preference)) { bytes = input.readNBytes(4097); }
+        java.util.Set<String> hidden = new java.util.HashSet<>();
+        if (bytes.length > 4096) return hidden;
+        for (String line : new String(bytes, java.nio.charset.StandardCharsets.US_ASCII).split("\\R")) {
+            String id = line.trim();
+            if (id.matches("[0-9]{1,30}")) hidden.add(id);
+        }
+        return hidden;
+    }
+
+    static void filter(Object adapter, java.nio.file.Path preference)
+            throws ReflectiveOperationException, java.io.IOException {
+        if (!"X.654".equals(adapter.getClass().getName())
+                || adapter.getClass().getSuperclass() != android.widget.BaseAdapter.class
+                || !java.nio.file.Files.isRegularFile(preference)) return;
+        java.util.Set<String> hidden = hiddenIds(preference);
+        if (hidden.isEmpty()) return;
+        Class<?> type = adapter.getClass();
+        var usersField = type.getField("A08");
+        if (usersField.getType() != java.util.List.class
+                || type.getField("A06").getType() != java.util.List.class
+                || type.getField("A07").getType() != java.util.List.class
+                || !type.getField("A04").getType().getName().equals("com.instagram.user.model.User")) return;
+        Object value = usersField.get(adapter);
+        if (!(value instanceof java.util.List<?> users)) return;
+        java.util.List<Object> visible = new java.util.ArrayList<>(users.size());
+        for (Object user : users) {
+            if (user == null || !user.getClass().getName().equals("com.instagram.user.model.User")) return;
+            Object id = user.getClass().getMethod("getId").invoke(user);
+            if (!(id instanceof String) || !hidden.contains(id)) visible.add(user);
+        }
+        if (visible.size() != users.size()) usersField.set(adapter, visible);
+    }
+}
