+package com.macapk.loader;
+
+/** The owner's compact Profile chip appearance, scoped to the known APK. */
+public final class InstagramProfileChipCompat {
+    private InstagramProfileChipCompat() {}
+
+    public static void apply(android.view.View view) {
+        if (!"X.Cbg".equals(view.getClass().getName())) return;
+        android.graphics.drawable.Drawable background = view.getBackground();
+        if (background == null || !"X.Cbq".equals(background.getClass().getName())) return;
+        android.view.ViewParent parent = view.getParent();
+        boolean profileRow = false;
+        while (parent instanceof android.view.View ancestor) {
+            if (ancestor.getId() == 0x7f0b04ef) { profileRow = true; break; }
+            parent = ancestor.getParent();
+        }
+        if (!profileRow) return;
+        try {
+            android.content.Context context = view.getContext();
+            if (context == null || !"com.instagram.android".equals(context.getPackageName())) return;
+            android.content.pm.PackageInfo info = context.getPackageManager()
+                    .getPackageInfo("com.instagram.android", 0);
+            if (info == null || !"445.0.0.45.83".equals(info.versionName)) return;
+            float density = context.getResources().getDisplayMetrics().density;
+            if (!Float.isFinite(density) || density <= 0) return;
+            java.lang.reflect.Field radius = background.getClass().getField("A03");
+            if (radius.getType() != float.class) return;
+            float current = radius.getFloat(background);
+            if (Math.abs(current - 99f * density) > 1f) return;
+            radius.setAccessible(true);
+            radius.setFloat(background, 8f * density);
+            background.invalidateSelf();
+        } catch (ReflectiveOperationException | RuntimeException
+                | android.content.pm.PackageManager.NameNotFoundException ignored) {
+            // Unknown APK fields or unavailable metadata keep the app's shape.
+        }
+    }
+}
