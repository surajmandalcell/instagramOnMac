+package com.macapk.loader;
+
+/** Desktop horizontal wheel support for Instagram's touch-only spring carousel. */
+public final class InstagramCarouselWheelCompat {
+    private InstagramCarouselWheelCompat() {}
+
+    public static boolean dispatch(android.view.View view, android.view.MotionEvent wheel) {
+        if (wheel == null || wheel.getActionMasked() != android.view.MotionEvent.ACTION_SCROLL
+                || !wheel.isFromSource(android.view.InputDevice.SOURCE_MOUSE)
+                || !view.isEnabled() || !"com.instagram.common.ui.widget.reboundhorizontalscrollview.ReboundHorizontalScrollView"
+                    .equals(view.getClass().getName())) return false;
+        float axis = wheel.getAxisValue(android.view.MotionEvent.AXIS_HSCROLL);
+        if (!Float.isFinite(axis) || axis == 0) return false;
+        android.content.Context context = view.getContext();
+        try {
+            if (context == null || !"com.instagram.android".equals(context.getPackageName())
+                    || !"445.0.0.45.83".equals(context.getPackageManager()
+                        .getPackageInfo("com.instagram.android", 0).versionName)) return false;
+        } catch (android.content.pm.PackageManager.NameNotFoundException | RuntimeException ignored) { return false; }
+        float delta = axis * android.view.ViewConfiguration.get(context).getScaledHorizontalScrollFactor();
+        if (!Float.isFinite(delta) || delta == 0 || !view.canScrollHorizontally(delta > 0 ? 1 : -1)) return false;
+        float lead = Math.copySign(android.view.ViewConfiguration.get(context).getScaledTouchSlop() * 2f + 1f, delta);
+        float x = view.getWidth() * .5f, y = view.getHeight() * .5f;
+        long time = wheel.getEventTime();
+        // The first scroll callback claims the app's drag. The second carries
+        // the wheel distance. CANCEL settles its spring without a click/fling.
+        send(view, time, android.view.MotionEvent.ACTION_DOWN, x, y);
+        send(view, time, android.view.MotionEvent.ACTION_MOVE, x - lead, y);
+        send(view, time, android.view.MotionEvent.ACTION_MOVE, x - lead - delta, y);
+        send(view, time, android.view.MotionEvent.ACTION_CANCEL, x - lead - delta, y);
+        return true;
+    }
+
+    private static void send(android.view.View view, long time, int action, float x, float y) {
+        android.view.MotionEvent event = android.view.MotionEvent.obtain(time, time, action, x, y, 0);
+        event.setSource(android.view.InputDevice.SOURCE_TOUCHSCREEN);
+        try { view.onTouchEvent(event); } finally { event.recycle(); }
+    }
+}
diff --git a/runtime/java/com/macapk/loader/InstagramDesktopTypography.java b/runtime/java/com/macapk/loader/InstagramDesktopTypography.java
new file mode 100644
--- /dev/null
+++ b/runtime/java/com/macapk/loader/InstagramDesktopTypography.java
@@ -0,0 +1,41 @@
+package com.macapk.loader;
+
+import android.content.Context;
+import android.view.View;
+import android.widget.TextView;
+import java.util.Collections;
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/** Compact desktop typography for identified Instagram 445 widgets. */
+public final class InstagramDesktopTypography {
+    private InstagramDesktopTypography() {}
+    private static final Map<Context,Boolean> SUPPORTED=Collections.synchronizedMap(new WeakHashMap<>());
+    private static boolean supported(Context context) {
+        if(context==null)return false;
+        Boolean known=SUPPORTED.get(context);
+        if(known!=null)return known;
+        boolean match=false;
+        try {match="com.instagram.android".equals(context.getPackageName())
+                && "445.0.0.45.83".equals(context.getPackageManager().getPackageInfo(context.getPackageName(),0).versionName);}
+        catch(Exception ignored){}
+        SUPPORTED.put(context,match);return match;
+    }
+    public static float cap(TextView view,float pixels) {
+        int id=view.getId();
+        if((id!=0x7f0b2d75 && id!=0x7f0b00e8)||!Float.isFinite(pixels)||pixels<=0)return pixels;
+        Context context=view.getContext();
+        if(!supported(context))return pixels;
+        float limit=11;
+        if(id==0x7f0b00e8) {
+            boolean profile=false;
+            for(android.view.ViewParent parent=view.getParent();parent instanceof View ancestor;parent=ancestor.getParent()) {
+                if(ancestor.getClass().getName().equals("com.instagram.profile.actionbar.ProfileActionBar")){profile=true;break;}
+            }
+            if(!profile)return pixels;
+            limit=20;
+        }
+        float scaled=context.getResources().getDisplayMetrics().scaledDensity;
+        return scaled>0 && Float.isFinite(scaled)?Math.min(pixels,limit*scaled):pixels;
+    }
+}
diff --git a/runtime/java/com/macapk/loader/InstagramGalleryCompat.java b/runtime/java/com/macapk/loader/InstagramGalleryCompat.java
new file mode 100644
--- /dev/null
+++ b/runtime/java/com/macapk/loader/InstagramGalleryCompat.java
@@ -0,0 +1,169 @@
+package com.macapk.loader;
+
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.view.View;
+import android.view.ViewGroup;
+
+/** Camera and Mac file browsing inside Instagram's first gallery grid cell. */
+public final class InstagramGalleryCompat {
+    private InstagramGalleryCompat() {}
+    private static final int CAMERA_CELL = 0x7f0b1abb;
+    private static final int CAMERA_BACKGROUND = 0x7f0b1aba;
+
+    public static void apply(View view) {
+        if (view.getId() != CAMERA_CELL || !(view instanceof ViewGroup cell)) return;
+        android.content.Context context = view.getContext();
+        if (context == null || !"com.instagram.android".equals(context.getPackageName())) return;
+        try {
+            if (!"445.0.0.45.83".equals(context.getPackageManager()
+                    .getPackageInfo(context.getPackageName(), 0).versionName)) return;
+        } catch (android.content.pm.PackageManager.NameNotFoundException missing) { return; }
+        view.post(() -> {
+            View background = null;
+            for (int i = 0; i < cell.getChildCount(); i++) {
+                View child = cell.getChildAt(i);
+                if (child.getId() == CAMERA_BACKGROUND) { background = child; break; }
+            }
+            if (isCamera(background)) install(cell, background, cell::performClick,
+                    () -> DocumentPickerHandler.macapkBrowseMedia(uri -> {
+                        // MediaStore notifies Recents; Instagram keeps its normal selection flow.
+                    }));
+        });
+    }
+
+    static boolean isCamera(View background) {
+        if (!(background instanceof android.widget.ImageView image)) return false;
+        if (!(background.getParent() instanceof View cell) || cell.getLayoutParams() == null) return false;
+        boolean cameraHolder = false;
+        for (Class<?> type = cell.getLayoutParams().getClass(); type != null; type = type.getSuperclass()) {
+            if (!"X.2kE".equals(type.getName())) continue;
+            try {
+                java.lang.reflect.Field field = type.getDeclaredField("A00");
+                field.setAccessible(true);
+                Object holder = field.get(cell.getLayoutParams());
+                cameraHolder = holder != null && "X.SGT".equals(holder.getClass().getName());
+            } catch (ReflectiveOperationException ignored) { return false; }
+            break;
+        }
+        if (!cameraHolder) return false;
+        android.graphics.drawable.Drawable drawable = image.getDrawable();
+        return drawable != null && "X.0WS".equals(drawable.getClass().getName())
+                && drawable.getIntrinsicWidth() > 0
+                && drawable.getIntrinsicWidth() == drawable.getIntrinsicHeight();
+    }
+
+    static SplitTile install(ViewGroup cell, View background, Runnable camera, Runnable browse) {
+        for (int i = 0; i < cell.getChildCount(); i++)
+            if (cell.getChildAt(i) instanceof SplitTile existing) return existing;
+        ViewGroup.LayoutParams source = background.getLayoutParams();
+        if (source == null) return null;
+        ViewGroup.LayoutParams layout;
+        try {
+            layout = (ViewGroup.LayoutParams) source.getClass()
+                    .getConstructor(int.class, int.class).newInstance(source.width, source.height);
+            // Reuse the camera's anchors and ratio, never its solver widget.
+            // MATCH_PARENT can resolve to zero in a wrap-content grid cell.
+            for (java.lang.reflect.Field field : source.getClass().getFields()) {
+                int modifiers = field.getModifiers();
+                if (java.lang.reflect.Modifier.isStatic(modifiers)
+                        || java.lang.reflect.Modifier.isFinal(modifiers)) continue;
+                if (field.getType().isPrimitive() || field.getType() == String.class)
+                    field.set(layout, field.get(source));
+            }
+        } catch (ReflectiveOperationException failure) {
+            NativeLog.w("Gallery", "Cannot create camera cell overlay constraints: " + failure);
+            return null;
+        }
+        if (!(background instanceof android.widget.ImageView image)) return null;
+        SplitTile tile = new SplitTile(cell, image, camera, browse);
+        cell.addView(tile, layout);
+        return tile;
+    }
+
+    static final class SplitTile extends ViewGroup {
+        final Action camera;
+        final Action browse;
+        private final android.widget.ImageView image;
+        private final android.graphics.drawable.Drawable cameraDrawable;
+
+        SplitTile(ViewGroup cell, android.widget.ImageView image, Runnable cameraAction, Runnable browseAction) {
+            super(cell.getContext());
+            this.image = image;
+            this.cameraDrawable = image.getDrawable();
+            camera = new Action(getContext(), "Camera", false, cameraAction);
+            browse = new Action(getContext(), "Browse", true, browseAction);
+            addView(camera);
+            addView(browse);
+        }
+
+        @Override protected void dispatchDraw(Canvas canvas) {
+            if (active()) super.dispatchDraw(canvas);
+        }
+
+        @Override public boolean dispatchTouchEvent(android.view.MotionEvent event) {
+            return active() && super.dispatchTouchEvent(event);
+        }
+
+        private boolean active() { return image.getDrawable() == cameraDrawable || isCamera(image); }
+
+        @Override protected void onMeasure(int widthSpec, int heightSpec) {
+            int width = MeasureSpec.getSize(widthSpec);
+            int height = MeasureSpec.getSize(heightSpec);
+            setMeasuredDimension(width, height);
+            camera.measure(MeasureSpec.makeMeasureSpec(width / 2, MeasureSpec.EXACTLY),
+                    MeasureSpec.makeMeasureSpec(height, MeasureSpec.EXACTLY));
+            browse.measure(MeasureSpec.makeMeasureSpec(width - width / 2, MeasureSpec.EXACTLY),
+                    MeasureSpec.makeMeasureSpec(height, MeasureSpec.EXACTLY));
+        }
+
+        @Override protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+            int width = right - left;
+            int height = bottom - top;
+            camera.layout(0, 0, width / 2, height);
+            browse.layout(width / 2, 0, width, height);
+        }
+    }
+
+    static final class Action extends View {
+        private final boolean file;
+        private final String label;
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        Action(android.content.Context context, String label, boolean file, Runnable action) {
+            super(context);
+            this.label = label;
+            this.file = file;
+            setContentDescription(file ? "Browse Mac files" : "Camera");
+            setBackgroundColor(0xff262a30);
+            setOnClickListener(view -> action.run());
+        }
+
+        @Override protected void onDraw(Canvas canvas) {
+            super.onDraw(canvas);
+            float width = getWidth(), height = getHeight();
+            float density = getContext() == null ? 1f : getResources().getDisplayMetrics().density;
+            float cx = width / 2f, cy = height * .43f;
+            float radius = 11f * density;
+            paint.setColor(0xfff8f9f9);
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(2f * density);
+            if (file) {
+                canvas.drawRoundRect(cx - radius * .7f, cy - radius,
+                        cx + radius * .7f, cy + radius, 2f * density, 2f * density, paint);
+                canvas.drawLine(cx - radius * .4f, cy + radius * .25f,
+                        cx + radius * .4f, cy + radius * .25f, paint);
+            } else {
+                canvas.drawRoundRect(cx - radius, cy - radius * .65f,
+                        cx + radius, cy + radius * .65f, 3f * density, 3f * density, paint);
+                canvas.drawCircle(cx, cy, radius * .32f, paint);
+                canvas.drawLine(cx - radius * .5f, cy - radius * .65f,
+                        cx - radius * .3f, cy - radius * .95f, paint);
+            }
+            paint.setStyle(Paint.Style.FILL);
+            paint.setTextAlign(Paint.Align.CENTER);
+            paint.setTextSize(12f * density);
+            canvas.drawText(label, cx, height * .7f, paint);
+        }
+    }
+}
diff --git a/runtime/java/com/macapk/loader/InstagramModeBarCompat.java b/runtime/java/com/macapk/loader/InstagramModeBarCompat.java
