@@ -0,0 +1,103 @@
+package com.macapk.loader;
+
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+/** Fit every Instagram creation destination inside the phone viewport. */
+public final class InstagramModeBarCompat {
+    private InstagramModeBarCompat() {}
+    private static final int SELECTOR = 0x7f0b28c7;
+    private static final int[] MODES = {0x7f0b0888, 0x7f0b088f, 0x7f0b0886, 0x7f0b088a};
+    private static final String[] NAMES = {"POST", "STORY", "REEL", "LIVE"};
+
+    public static void apply(View view) {
+        if (view.getId() != SELECTOR || !(view instanceof FrameLayout selector)
+                || !"com.instagram.creation.capture.quickcapture.cameradestinationpicker.ui.LegacyCameraDestinationScrollView"
+                    .equals(view.getClass().getName())) return;
+        android.content.Context context = view.getContext();
+        if (context == null || !"com.instagram.android".equals(context.getPackageName())) return;
+        try {
+            if (!"445.0.0.45.83".equals(context.getPackageManager()
+                    .getPackageInfo(context.getPackageName(), 0).versionName)) return;
+        } catch (android.content.pm.PackageManager.NameNotFoundException missing) { return; }
+        view.post(() -> {
+            TextView[] originals = new TextView[MODES.length];
+            for (int i = 0; i < MODES.length; i++) {
+                View label = selector.findViewById(MODES[i]);
+                if (!(label instanceof TextView text) || !text.isClickable()) return;
+                originals[i] = text;
+            }
+            install(selector, originals);
+        });
+    }
+
+    static ModeBar install(FrameLayout selector, TextView[] originals) {
+        for (int i = 0; i < selector.getChildCount(); i++)
+            if (selector.getChildAt(i) instanceof ModeBar existing) return existing;
+        if (originals == null || originals.length != MODES.length) return null;
+        for (TextView label : originals) if (label == null) return null;
+        ModeBar bar = new ModeBar(selector, originals);
+        selector.addView(bar, new FrameLayout.LayoutParams(-1, -1));
+        return bar;
+    }
+
+    static final class ModeBar extends android.view.ViewGroup {
+        final TextView[] originals;
+        final TextView[] buttons = new TextView[MODES.length];
+
+        ModeBar(FrameLayout selector, TextView[] originals) {
+            super(selector.getContext());
+            this.originals = originals;
+            setBackgroundColor(0xff191c1f);
+            for (int i = 0; i < buttons.length; i++) {
+                final int index = i;
+                TextView button = new TextView(getContext());
+                button.setText(NAMES[i]);
+                button.setContentDescription(NAMES[i]);
+                button.setTextSize(14);
+                button.setGravity(Gravity.CENTER);
+                button.setOnClickListener(view -> {
+                    originals[index].performClick();
+                    select(index);
+                });
+                buttons[i] = button;
+                addView(button);
+            }
+            refresh();
+        }
+
+        void refresh() {
+            int selected = 0;
+            for (int i = 0; i < originals.length; i++)
+                if (originals[i].isSelected()) { selected = i; break; }
+            select(selected);
+        }
+
+        void select(int selected) {
+            for (int i = 0; i < buttons.length; i++)
+                buttons[i].setTextColor(i == selected ? 0xfff8f9f9 : 0xff898b8e);
+        }
+
+        @Override protected void onMeasure(int widthSpec, int heightSpec) {
+            int width = MeasureSpec.getSize(widthSpec);
+            int height = MeasureSpec.getSize(heightSpec);
+            setMeasuredDimension(width, height);
+            for (int i = 0; i < buttons.length; i++) {
+                int start = width * i / buttons.length;
+                int end = width * (i + 1) / buttons.length;
+                buttons[i].measure(MeasureSpec.makeMeasureSpec(end - start, MeasureSpec.EXACTLY),
+                        MeasureSpec.makeMeasureSpec(height, MeasureSpec.EXACTLY));
+            }
+        }
+
+        @Override protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+            int width = right - left;
+            int height = bottom - top;
+            for (int i = 0; i < buttons.length; i++)
+                buttons[i].layout(width * i / buttons.length, 0,
+                        width * (i + 1) / buttons.length, height);
+        }
+    }
+}
