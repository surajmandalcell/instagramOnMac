+package com.macapk.loader;
+
+import android.hardware.Camera;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/** Camera1's primitive getters cannot express unavailable desktop lens data.
+ * The scoped guest adapter keeps this sentinel internal and publishes the
+ * app's camera2 representation: an empty sensor list and nullable angles. */
+public final class InstagramOptionalOptics {
+    private InstagramOptionalOptics() {}
+    public static float focalLength(Camera.Parameters p) {
+        return p.get("focal-length") == null ? Float.NaN : p.getFocalLength();
+    }
+    public static float horizontalAngle(Camera.Parameters p) {
+        return p.get("horizontal-view-angle") == null ? Float.NaN : p.getHorizontalViewAngle();
+    }
+    public static float verticalAngle(Camera.Parameters p) {
+        return p.get("vertical-view-angle") == null ? Float.NaN : p.getVerticalViewAngle();
+    }
+    public static List<?> sensorSize(Object[] values) {
+        for (Object value : values) {
+            if (value instanceof Float f && !Float.isFinite(f)) return Collections.emptyList();
+        }
+        return Arrays.asList(values);
+    }
+    public static Float optionalAngle(float value) {
+        return Float.isFinite(value) ? Float.valueOf(value) : null;
+    }
+}
