+extern "C" float macapk_audio_master_volume();
+// AVPlayer owns file demux, audio and presentation time. Frames use the same
+// retained CVPixelBuffer -> NativeMedia -> scoped SurfaceTexture route as codecs.
+struct MediaPlayerFileVideo {
+    AVPlayer* player = nil;
+    AVPlayerItem* item = nil;
+    AVPlayerItemVideoOutput* output = nil;
+    int width = 0, height = 0;
+    int64_t duration = 0;
+    float appGain = 1;
+    float appliedGain = -1;
+    std::shared_ptr<std::atomic<bool>> seeking = std::make_shared<std::atomic<bool>>(false);
+    std::shared_ptr<std::atomic<uint64_t>> seekTicket = std::make_shared<std::atomic<uint64_t>>(0);
+    std::shared_ptr<std::atomic<float>> desiredRate = std::make_shared<std::atomic<float>>(0);
+    std::shared_ptr<std::atomic<bool>> closed = std::make_shared<std::atomic<bool>>(false);
+    std::shared_ptr<std::mutex> commandLock = std::make_shared<std::mutex>();
+};
+static void PlayerVideoUpdateGain(MediaPlayerFileVideo* video) {
+    const char* muted = std::getenv("MACAPK_AUDIO_MUTE");
+    float gain = MacApkVolumeGain(video->appGain * macapk_audio_master_volume(), muted && muted[0] == '1');
+    if (gain != video->appliedGain) {
+        video->player.volume = gain;
+        video->appliedGain = gain;
+    }
+}
+static jlong PlayerVideoOpen(JNIEnv* env, jclass, jstring input) {
+  @autoreleasepool {
+    if (!input) return 0;
+    const jchar* chars = env->GetStringChars(input, nullptr);
+    if (!chars) return 0;
+    NSString* path = [NSString stringWithCharacters:(const unichar*)chars length:env->GetStringLength(input)];
+    env->ReleaseStringChars(input, chars);
+    AVURLAsset* asset = [AVURLAsset URLAssetWithURL:[NSURL fileURLWithPath:path] options:nil];
+    AVAssetTrack* track = [[asset tracksWithMediaType:AVMediaTypeVideo] firstObject];
+    double seconds = CMTimeGetSeconds(asset.duration);
+    if (!track || !std::isfinite(seconds) || seconds <= 0) return 0;
+    auto* video = new MediaPlayerFileVideo();
+    CGSize natural = track.naturalSize;
+    CGRect transformed = CGRectApplyAffineTransform(CGRectMake(0, 0, natural.width, natural.height), track.preferredTransform);
+    video->width = (int)std::llround(std::abs(transformed.size.width));
+    video->height = (int)std::llround(std::abs(transformed.size.height));
+    video->duration = (int64_t)std::llround(seconds * 1000);
+    video->item = [AVPlayerItem playerItemWithAsset:asset];
+    if (!CGAffineTransformIsIdentity(track.preferredTransform))
+        video->item.videoComposition = [AVVideoComposition videoCompositionWithPropertiesOfAsset:asset];
+    video->output = [[AVPlayerItemVideoOutput alloc] initWithPixelBufferAttributes:@{
+        (id)kCVPixelBufferPixelFormatTypeKey:@(kCVPixelFormatType_32BGRA),
+        (id)kCVPixelBufferIOSurfacePropertiesKey:@{}, (id)kCVPixelBufferMetalCompatibilityKey:@YES}];
+    [video->item addOutput:video->output];
+    video->player = [AVPlayer playerWithPlayerItem:video->item];
+#if !__has_feature(objc_arc)
+    // This production translation unit uses manual reference counting. The
+    // autoreleased factory objects must outlive this JNI autorelease pool.
+    [video->item retain];
+    [video->player retain];
+#endif
+    video->player.automaticallyWaitsToMinimizeStalling = NO;
+    video->player.actionAtItemEnd = AVPlayerActionAtItemEndPause;
+    PlayerVideoUpdateGain(video);
+    return (jlong)(uintptr_t)video;
+  }
+}
+static jlongArray PlayerVideoInfo(JNIEnv* env, jclass, jlong handle) {
+  @autoreleasepool {
+    auto* video = (MediaPlayerFileVideo*)(uintptr_t)handle;
+    if (!video) return nullptr;
+    PlayerVideoUpdateGain(video);
+    int status = video->item.status == AVPlayerItemStatusReadyToPlay ? 1
+        : video->item.status == AVPlayerItemStatusFailed ? -1 : 0;
+    double seconds = CMTimeGetSeconds(video->player.currentTime);
+    jlong values[] = {video->width, video->height, video->duration, status,
+        std::isfinite(seconds) ? (jlong)std::llround(seconds * 1000) : 0,
+        video->seeking->load() ? 1 : 0};
+    jlongArray result = env->NewLongArray(6);
+    if (result) env->SetLongArrayRegion(result, 0, 6, values);
+    return result;
+  }
+}
+static jlongArray PlayerVideoFrame(JNIEnv* env, jclass, jlong handle) {
+  @autoreleasepool {
+    auto* video = (MediaPlayerFileVideo*)(uintptr_t)handle;
+    if (!video) return nullptr;
+    PlayerVideoUpdateGain(video);
+    CMTime time = video->player.currentTime;
+    if (![video->output hasNewPixelBufferForItemTime:time]) return nullptr;
+    CMTime actualTime = kCMTimeInvalid;
+    CVPixelBufferRef frame = [video->output copyPixelBufferForItemTime:time itemTimeForDisplay:&actualTime];
+    if (!frame) return nullptr;
+    double seconds = CMTimeGetSeconds(actualTime);
+    jlong values[] = {(jlong)(uintptr_t)frame, (jlong)CVPixelBufferGetWidth(frame), (jlong)CVPixelBufferGetHeight(frame),
+        std::isfinite(seconds) ? (jlong)std::llround(seconds * 1000) : -1};
+    jlongArray result = env->NewLongArray(4);
+    if (result) env->SetLongArrayRegion(result, 0, 4, values);
