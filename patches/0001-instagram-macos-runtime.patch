+struct BackingReflow { int width_pt, height_pt; double factor; };
+// Keep guest pixels (and process-fixed Android density) stable across displays.
+// Only shrink further when the new display cannot fit the existing canvas.
+inline BackingReflow ReflowBacking(int width_pt, int height_pt,
+        double old_backing, double new_backing, double budget_w, double budget_h) {
+    if (!(old_backing>=0.5 && old_backing<=8)) old_backing=1;
+    if (!(new_backing>=0.5 && new_backing<=8)) new_backing=1;
+    double factor=old_backing/new_backing;
+    factor=std::min(factor,std::min(budget_w/std::max(1,width_pt),budget_h/std::max(1,height_pt)));
+    return {std::max(1,(int)std::lround(width_pt*factor)),
+            std::max(1,(int)std::lround(height_pt*factor)),factor};
+}
 
