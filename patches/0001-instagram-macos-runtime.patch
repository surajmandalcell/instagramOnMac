new file mode 100644
--- /dev/null
+++ b/launcher/AppStubArguments.swift
@@ -0,0 +1,44 @@
+func appStubArguments(execPath: String, apkPath: String, androidRootPath: String,
+                      package: String, windowScale: Double = 2) -> [String] {
+    var arguments = [execPath, "--apk", apkPath, "--android-root", androidRootPath]
+    if package == "com.instagram.android" {
+        arguments += ["--orientation", "portrait",
+                      "--width", String(Int((393 * windowScale).rounded(.down))),
+                      "--height", String(Int((851 * windowScale).rounded(.down)))]
+    }
+    return arguments
+}
+
+func appStubJvmOptions(package: String, existing: String?) -> String? {
+    existing ?? (package == "com.instagram.android" ? "-Xmx2g -XX:MaxNewSize=256m" : nil)
+}
+
+func appStubSdkInt(package: String, existing: String?) -> String? {
+    existing ?? (package == "com.instagram.android" ? "33" : nil)
+}
+
+func appStubWindowScale(availableWidth: Double, availableHeight: Double) -> Double {
+    min(2, min(availableWidth / 393, availableHeight / 851))
+}
+
+func appStubLaunchScreenIndex(package: String, existingID: String?,
+                              screens: [(id: String, width: Double, height: Double)]) -> Int? {
+    if let existingID { return screens.firstIndex { $0.id == existingID } }
+    guard package == "com.instagram.android" else { return nil }
+    return screens.indices.filter {
+        !screens[$0].id.isEmpty && screens[$0].width.isFinite && screens[$0].height.isFinite
+            && screens[$0].width > 0 && screens[$0].height > 0
+    }.max {
+        let first = min(screens[$0].width / 393, screens[$0].height / 851)
+        let second = min(screens[$1].width / 393, screens[$1].height / 851)
+        return first == second ? screens[$0].id > screens[$1].id : first < second
+    }
+}
+
+func appStubDisplayDensity(package: String, existing: String?, backingScale: Double,
+                          windowScale: Double = 2) -> String? {
+    if let existing { return existing }
+    guard package == "com.instagram.android" else { return nil }
+    let scale = backingScale.isFinite && backingScale > 0 ? backingScale : 1
+    return String(Int(min(max(160 * windowScale * scale, 120), 640).rounded()))
+}
