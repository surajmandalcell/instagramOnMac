+static void PlayerVideoCommand(JNIEnv*, jclass, jlong handle, jint command, jdouble value) {
+  @autoreleasepool {
+    auto* video = (MediaPlayerFileVideo*)(uintptr_t)handle;
+    if (!video) return;
+    switch (command) {
+      case 1: {
+        std::lock_guard<std::mutex> lock(*video->commandLock);
+        video->desiredRate->store((float)value);
+        if (!video->seeking->load()) video->player.rate = (float)value;
+        break;
+      }
+      case 2: {
+        std::lock_guard<std::mutex> lock(*video->commandLock);
+        video->desiredRate->store(0);
+        [video->player pause]; break;
+      }
+      case 3: {
+        auto seeking = video->seeking;
+        auto tickets = video->seekTicket;
+        auto desired = video->desiredRate;
+        auto closed = video->closed;
+        auto commandLock = video->commandLock;
+        AVPlayer* player = video->player;
+        uint64_t ticket;
+        {
+            std::lock_guard<std::mutex> lock(*commandLock);
+            ticket = tickets->fetch_add(1) + 1;
+            seeking->store(true);
+        }
+        [video->player seekToTime:CMTimeMake((int64_t)value, 1000)
+                    toleranceBefore:kCMTimeZero toleranceAfter:kCMTimeZero
+                    completionHandler:^(BOOL finished) {
+                        std::lock_guard<std::mutex> lock(*commandLock);
+                        if (finished && tickets->load() == ticket) {
+                            if (!closed->load()) player.rate = desired->load();
+                            seeking->store(false);
+                        }
+                    }];
+        break;
+      }
+      case 4: video->appGain = (float)value; PlayerVideoUpdateGain(video); break;
+    }
+  }
+}
+static void PlayerVideoClose(JNIEnv*, jclass, jlong handle) {
+  @autoreleasepool {
+    auto* video = (MediaPlayerFileVideo*)(uintptr_t)handle;
+    if (!video) return;
+    {
+        std::lock_guard<std::mutex> lock(*video->commandLock);
+        video->closed->store(true);
+        video->desiredRate->store(0);
+        [video->player pause];
+        [video->player replaceCurrentItemWithPlayerItem:nil];
+    }
+    [video->item removeOutput:video->output];
