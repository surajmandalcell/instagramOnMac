+    /** AOSP SQLiteSession.executeSpecial: raw transaction SQL uses the same
+     * per-thread transaction stack as the Java API, including nested scopes. */
+    synchronized boolean macapkExecuteSpecial(String sql) {
+        throwIfNotOpen();
+        switch (DatabaseUtils.getSqlStatementType(sql)) {
+            case DatabaseUtils.STATEMENT_BEGIN:
+                beginTransaction();
+                return true;
+            case DatabaseUtils.STATEMENT_COMMIT:
+                setTransactionSuccessful();
+                endTransaction();
+                return true;
+            case DatabaseUtils.STATEMENT_ABORT:
+                endTransaction();
+                return true;
+            default:
+                return false;
+        }
     }
 
