+package com.macapk.loader;
+
+import android.graphics.SurfaceTexture;
+import android.media.MediaFormat;
+import android.view.Surface;
+import java.nio.ByteBuffer;
+
+/** AVC surface encoder backed by the host VideoToolbox compression session. */
+public final class NativeVideoEncoder {
+    public static native long open(int width, int height, int bitrate, int fps, int keyIntervalSeconds);
+    public static native int queueArgb(long handle, int[] argb, int width, int height, long ptsUs);
+    public static native byte[] poll(long handle, long[] info);
+    public static native byte[] csd(long handle, int index);
+    public static native int end(long handle);
+    public static native void close(long handle);
+
+    public record Packet(byte[] bytes, long ptsUs, int flags) {}
+    private final Object lock = new Object();
+    private final int width, height, bitrate, fps, keyInterval;
+    private final InputTexture texture;
+    private Surface surface;
+    private long handle;
+    private boolean closed, ended;
+
+    public NativeVideoEncoder(MediaFormat format) {
+        width = format.getInteger(MediaFormat.KEY_WIDTH);
+        height = format.getInteger(MediaFormat.KEY_HEIGHT);
+        bitrate = format.getInteger(MediaFormat.KEY_BIT_RATE, 5_000_000);
+        fps = Math.max(1, format.getNumber(MediaFormat.KEY_FRAME_RATE, 30).intValue());
+        keyInterval = Math.max(0, format.getNumber(MediaFormat.KEY_I_FRAME_INTERVAL, 1).intValue());
+        if (width <= 0 || height <= 0 || bitrate <= 0) throw new IllegalArgumentException("Invalid AVC encoder format");
+        texture = new InputTexture();
+        texture.setDefaultBufferSize(width, height);
+    }
+
+    public Surface inputSurface() {
+        synchronized (lock) {
+            if (closed) throw new IllegalStateException("Encoder is closed");
+            if (surface == null) surface = Surface.macapkForEncoder(texture);
+            return surface;
+        }
+    }
+    public void start() {
+        synchronized (lock) {
+            if (closed || handle != 0) throw new IllegalStateException("Encoder cannot start");
+            handle = open(width, height, bitrate, fps, keyInterval);
+            if (handle == 0) throw new IllegalStateException("VideoToolbox AVC encoder could not start");
+        }
+    }
+    public Packet pollPacket() {
+        synchronized (lock) {
+            if (handle == 0) return null;
+            long[] info = new long[2];
+            byte[] bytes = poll(handle, info);
+            return bytes == null ? null : new Packet(bytes, info[0], (int) info[1]);
+        }
+    }
+    public MediaFormat outputFormat() {
+        synchronized (lock) {
+            byte[] sps = handle == 0 ? null : csd(handle, 0);
+            byte[] pps = handle == 0 ? null : csd(handle, 1);
+            if (sps == null || pps == null) return null;
+            MediaFormat format = MediaFormat.createVideoFormat("video/avc", width, height);
+            format.setInteger(MediaFormat.KEY_BIT_RATE, bitrate);
+            format.setInteger(MediaFormat.KEY_FRAME_RATE, fps);
+            format.setByteBuffer("csd-0", ByteBuffer.wrap(sps));
+            format.setByteBuffer("csd-1", ByteBuffer.wrap(pps));
+            return format;
+        }
+    }
+    public void endInput() {
+        synchronized (lock) {
+            if (handle == 0 || closed || ended) throw new IllegalStateException("Encoder input is not running");
+            if (end(handle) < 0) throw new IllegalStateException("VideoToolbox encoder could not finish");
+            ended = true;
+        }
+    }
+    public void release() {
+        synchronized (lock) {
+            closed = true;
+            if (handle != 0) { close(handle); handle = 0; }
+            if (surface != null) surface.release();
+            texture.release();
+        }
+    }
+    private final class InputTexture extends SurfaceTexture {
+        private long presentationTimeNs = -1;
+        InputTexture() { super(false); }
+        @Override public void macapkSetProducerPresentationTime(long timeNs) { presentationTimeNs = timeNs; }
+        @Override public void macapkQueueProducerFrame(int[] argb, int w, int h, int stride,
+                float[] transform, java.util.function.Consumer<int[]> recycler, boolean premultiplied) {
+            try {
+                if (stride != w || w != width || h != height) throw new IllegalArgumentException("Encoder input dimensions changed");
+                long ptsUs = presentationTimeNs >= 0 ? presentationTimeNs / 1000 : System.nanoTime() / 1000;
+                long deadline = System.nanoTime() + 5_000_000_000L;
+                for (;;) {
+                    int status;
+                    synchronized (lock) {
+                        if (closed || handle == 0 || ended) throw new IllegalStateException("Encoder input is not running");
+                        status = queueArgb(handle, argb, w, h, ptsUs);
+                    }
+                    if (status == 0) return;
+                    if (status != -11 || System.nanoTime() >= deadline)
+                        throw new IllegalStateException("VideoToolbox encoder rejected input: " + status);
+                    try { Thread.sleep(1); }
+                    catch (InterruptedException interrupted) { Thread.currentThread().interrupt(); throw new IllegalStateException("Encoder input interrupted", interrupted); }
+                }
+            } finally { if (recycler != null) recycler.accept(argb); }
+        }
+    }
+}
