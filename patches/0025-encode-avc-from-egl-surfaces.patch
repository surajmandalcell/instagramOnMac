+#import <VideoToolbox/VideoToolbox.h>
+#import <Foundation/Foundation.h>
+#include <jni.h>
+#include <deque>
+#include <mutex>
+#include <vector>
+#include <cstring>
+
+namespace macapk::video_encoder {
+struct Packet { std::vector<uint8_t> bytes; int64_t pts; int flags; };
+struct Encoder {
+    VTCompressionSessionRef session = nullptr;
+    int width, height;
+    std::mutex mutex;
+    std::deque<Packet> packets;
+    std::vector<uint8_t> sps, pps;
+    OSStatus error = noErr;
+    bool ended = false, eosRead = false;
+};
+static void appendNal(std::vector<uint8_t>& dst, const uint8_t* data, size_t size) {
+    const uint8_t prefix[] = {0, 0, 0, 1};
+    dst.insert(dst.end(), prefix, prefix + 4);
+    dst.insert(dst.end(), data, data + size);
+}
+static void encoded(void* context, void*, OSStatus status, VTEncodeInfoFlags flags,
+                    CMSampleBufferRef sample) {
+    Encoder* e = static_cast<Encoder*>(context);
+    std::lock_guard<std::mutex> lock(e->mutex);
+    if (status != noErr || (flags & kVTEncodeInfo_FrameDropped) || !sample) {
+        e->error = status != noErr ? status : -1;
+        return;
+    }
+    CMFormatDescriptionRef format = CMSampleBufferGetFormatDescription(sample);
+    int nalLength = 4;
+    for (size_t i = 0; i < 2; ++i) {
+        const uint8_t* data = nullptr;
+        size_t size = 0, count = 0;
+        OSStatus result = CMVideoFormatDescriptionGetH264ParameterSetAtIndex(
+                format, i, &data, &size, &count, &nalLength);
+        if (result == noErr && data && size) {
+            auto& target = i == 0 ? e->sps : e->pps;
+            target.clear(); appendNal(target, data, size);
+        }
+    }
+    CMBlockBufferRef block = CMSampleBufferGetDataBuffer(sample);
+    const size_t size = block ? CMBlockBufferGetDataLength(block) : 0;
+    std::vector<uint8_t> avcc(size);
+    if (!size || CMBlockBufferCopyDataBytes(block, 0, size, avcc.data()) != kCMBlockBufferNoErr) {
+        e->error = -2; return;
+    }
+    Packet packet;
+    packet.pts = CMTimeConvertScale(CMSampleBufferGetPresentationTimeStamp(sample),
+                                   1000000, kCMTimeRoundingMethod_Default).value;
+    CFArrayRef attachments = CMSampleBufferGetSampleAttachmentsArray(sample, false);
+    bool notSync = false;
+    if (attachments && CFArrayGetCount(attachments)) {
+        auto dict = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(attachments, 0));
+        notSync = CFDictionaryGetValue(dict, kCMSampleAttachmentKey_NotSync) == kCFBooleanTrue;
+    }
+    packet.flags = notSync ? 0 : 1;
+    size_t offset = 0;
+    while (offset + nalLength <= size) {
+        uint32_t length = 0;
+        for (int n = 0; n < nalLength; ++n) length = (length << 8) | avcc[offset++];
+        if (!length || length > size - offset) { e->error = -3; return; }
+        appendNal(packet.bytes, avcc.data() + offset, length);
+        offset += length;
+    }
+    if (offset != size || e->packets.size() >= 8) { e->error = -4; return; }
+    e->packets.push_back(std::move(packet));
+}
+static void number(VTCompressionSessionRef session, CFStringRef key, int value) {
+    CFNumberRef n = CFNumberCreate(nullptr, kCFNumberIntType, &value);
+    VTSessionSetProperty(session, key, n); CFRelease(n);
+}
+static jlong open(JNIEnv*, jclass, jint width, jint height, jint bitrate, jint fps, jint interval) {
+    @autoreleasepool {
+    if (width <= 0 || height <= 0 || width > 8192 || height > 8192 || fps <= 0 || fps > 240) return 0;
+    Encoder* e = new Encoder(); e->width = width; e->height = height;
+    NSDictionary* attributes = @{
+        (id)kCVPixelBufferPixelFormatTypeKey: @(kCVPixelFormatType_32BGRA),
+        (id)kCVPixelBufferWidthKey: @(width), (id)kCVPixelBufferHeightKey: @(height),
+        (id)kCVPixelBufferIOSurfacePropertiesKey: @{}
+    };
+    NSDictionary* specification = @{
+        (id)kVTVideoEncoderSpecification_EnableHardwareAcceleratedVideoEncoder: @YES
+    };
+    OSStatus result = VTCompressionSessionCreate(nullptr, width, height, kCMVideoCodecType_H264,
+        (__bridge CFDictionaryRef)specification, (__bridge CFDictionaryRef)attributes,
+        nullptr, encoded, e, &e->session);
+    if (result != noErr || !e->session) { delete e; return 0; }
+    VTSessionSetProperty(e->session, kVTCompressionPropertyKey_AllowFrameReordering, kCFBooleanFalse);
+    VTSessionSetProperty(e->session, kVTCompressionPropertyKey_RealTime, kCFBooleanTrue);
+    VTSessionSetProperty(e->session, kVTCompressionPropertyKey_ProfileLevel, kVTProfileLevel_H264_Baseline_AutoLevel);
+    number(e->session, kVTCompressionPropertyKey_AverageBitRate, bitrate > 0 ? bitrate : 5000000);
+    number(e->session, kVTCompressionPropertyKey_ExpectedFrameRate, fps);
