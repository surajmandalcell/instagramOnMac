+    CVPixelBufferRef pixel = nullptr;
+    CVPixelBufferPoolRef pool = VTCompressionSessionGetPixelBufferPool(e->session);
+    if (!pool || CVPixelBufferPoolCreatePixelBuffer(nullptr, pool, &pixel) != kCVReturnSuccess) return -2;
+    CVPixelBufferLockBaseAddress(pixel, 0);
+    uint8_t* dest = static_cast<uint8_t*>(CVPixelBufferGetBaseAddress(pixel));
+    size_t stride = CVPixelBufferGetBytesPerRow(pixel);
+    jint* source = env->GetIntArrayElements(argb, nullptr);
+    if (!source) { CVPixelBufferUnlockBaseAddress(pixel, 0); CFRelease(pixel); return -3; }
+    // Java ARGB ints are BGRA bytes on the supported little-endian Mac hosts.
+    for (int y = 0; y < height; ++y) std::memcpy(dest + y * stride, source + y * width, width * 4);
+    env->ReleaseIntArrayElements(argb, source, JNI_ABORT);
+    CVPixelBufferUnlockBaseAddress(pixel, 0);
+    OSStatus result = VTCompressionSessionEncodeFrame(e->session, pixel, CMTimeMake(pts, 1000000),
+        kCMTimeInvalid, nullptr, nullptr, nullptr);
+    CFRelease(pixel);
+    // Resolve callbacks before returning, bounding retained frame/output memory.
+    if (result == noErr) result = VTCompressionSessionCompleteFrames(e->session, CMTimeMake(pts, 1000000));
+    return result;
+}
+static jbyteArray bytes(JNIEnv* env, const std::vector<uint8_t>& data) {
+    jbyteArray result = env->NewByteArray(static_cast<jsize>(data.size()));
+    if (result && !data.empty()) env->SetByteArrayRegion(result, 0, data.size(), reinterpret_cast<const jbyte*>(data.data()));
+    return result;
+}
+static jbyteArray poll(JNIEnv* env, jclass, jlong handle, jlongArray info) {
+    Encoder* e = reinterpret_cast<Encoder*>(handle);
+    if (!e || !info || env->GetArrayLength(info) < 2) return nullptr;
+    std::lock_guard<std::mutex> lock(e->mutex);
+    if (e->error) {
+        jclass error = env->FindClass("java/lang/IllegalStateException");
+        env->ThrowNew(error, "VideoToolbox encoder failed"); return nullptr;
+    }
+    if (!e->packets.empty()) {
+        Packet& packet = e->packets.front();
+        jlong metadata[] = {packet.pts, packet.flags};
+        env->SetLongArrayRegion(info, 0, 2, metadata);
+        jbyteArray result = bytes(env, packet.bytes); e->packets.pop_front(); return result;
+    }
+    if (e->ended && !e->eosRead) {
+        e->eosRead = true; jlong metadata[] = {0, 4};
+        env->SetLongArrayRegion(info, 0, 2, metadata); return env->NewByteArray(0);
+    }
+    return nullptr;
+}
+static jbyteArray csd(JNIEnv* env, jclass, jlong handle, jint index) {
+    Encoder* e = reinterpret_cast<Encoder*>(handle); if (!e || index < 0 || index > 1) return nullptr;
+    std::lock_guard<std::mutex> lock(e->mutex);
+    const auto& data = index == 0 ? e->sps : e->pps;
+    return data.empty() ? nullptr : bytes(env, data);
+}
+static jint end(JNIEnv*, jclass, jlong handle) {
+    Encoder* e = reinterpret_cast<Encoder*>(handle); if (!e) return -1;
+    OSStatus result = VTCompressionSessionCompleteFrames(e->session, kCMTimeInvalid);
+    std::lock_guard<std::mutex> lock(e->mutex); e->ended = true; return result;
+}
+static void close(JNIEnv*, jclass, jlong handle) {
+    Encoder* e = reinterpret_cast<Encoder*>(handle); if (!e) return;
+    VTCompressionSessionCompleteFrames(e->session, kCMTimeInvalid);
+    VTCompressionSessionInvalidate(e->session); CFRelease(e->session); delete e;
+}
+void RegisterNativeVideoEncoderMethods(JNIEnv* env) {
+    jclass cls = env->FindClass("com/macapk/loader/NativeVideoEncoder");
+    if (!cls) { env->ExceptionClear(); return; }
+    JNINativeMethod methods[] = {
+        {(char*)"open", (char*)"(IIIII)J", (void*)open},
+        {(char*)"queueArgb", (char*)"(J[IIIJ)I", (void*)queueArgb},
+        {(char*)"poll", (char*)"(J[J)[B", (void*)poll},
+        {(char*)"csd", (char*)"(JI)[B", (void*)csd},
+        {(char*)"end", (char*)"(J)I", (void*)end},
+        {(char*)"close", (char*)"(J)V", (void*)close}
+    };
+    env->RegisterNatives(cls, methods, sizeof(methods) / sizeof(methods[0]));
+    env->DeleteLocalRef(cls);
+}
+}
