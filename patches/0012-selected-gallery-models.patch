+package com.macapk.loader;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/** Filters the tested gallery model before it computes adapter rows and positions. */
+public final class InstagramGallerySelectionCompat {
+    private InstagramGallerySelectionCompat() {}
+
+    public static void sanitizeModel(Object model) {
+        if (model == null || !"X.D5A".equals(model.getClass().getName())) return;
+        Map<Integer, String> selected = android.provider.MediaStoreProvider.macapkSelectedReferenceSnapshot();
+        for (String name : new String[]{"A0T", "A0U", "A0V", "A0W", "A0X", "A0Y"}) {
+            try {
+                Field field = model.getClass().getField(name);
+                field.setAccessible(true);
+                Object value = field.get(model);
+                if (!(value instanceof List<?> source)) continue;
+                List<Object> filtered = new ArrayList<>();
+                for (Object item : source) if (allowed(item, selected)) filtered.add(item);
+                // Never remove from a shared source/cache list. The UI model owns this copy.
+                field.set(model, filtered);
+            } catch (ReflectiveOperationException failure) {
+                throw new IllegalStateException("The tested gallery model shape changed", failure);
+            }
+        }
+    }
+
+    private static boolean allowed(Object item, Map<Integer, String> selected) {
+        if (item == null) return false;
+        if ("com.instagram.common.gallery.model.GalleryItem$CameraCaptureMedium".equals(item.getClass().getName())) return true;
+        try {
+            Object medium = item;
+            if (!"com.instagram.common.gallery.Medium".equals(item.getClass().getName())) {
+                medium = item.getClass().getField("A02").get(item);
+                if (medium == null && "com.instagram.common.gallery.model.GalleryItem$LocalGalleryMedium".equals(item.getClass().getName()))
+                    medium = item.getClass().getField("A00").get(item);
+            }
+            if (medium == null || !"com.instagram.common.gallery.Medium".equals(medium.getClass().getName())) return false;
+            int id = medium.getClass().getField("A06").getInt(medium);
+            Object data = medium.getClass().getField("A0e").get(medium);
+            return data instanceof String && data.equals(selected.get(id));
+        } catch (ReflectiveOperationException unsupportedItem) { return false; }
+    }
+}
