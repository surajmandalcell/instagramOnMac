+package android.view;
+
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.IInterface;
+
+/** Local window policy queried by apps through Android's hidden service API. */
+public interface IWindowManager extends IInterface {
+    boolean hasNavigationBar();
+    boolean hasNavigationBar(int displayId);
+
+    /** Only the in-process service is supported; there is no remote Binder proxy. */
+    public static class Stub extends Binder implements IWindowManager {
+        private static final String DESCRIPTOR = "android.view.IWindowManager";
+
+        public Stub() { attachInterface(this, DESCRIPTOR); }
+
+        public static IWindowManager asInterface(IBinder binder) {
+            if (binder == null) return null;
+            IInterface local = binder.queryLocalInterface(DESCRIPTOR);
+            return local instanceof IWindowManager ? (IWindowManager) local : null;
+        }
+
+        public IBinder asBinder() { return this; }
+        public boolean hasNavigationBar() {
+            return com.macapk.loader.StatusBarDriver.systemBarsEnabled();
+        }
+        public boolean hasNavigationBar(int displayId) { return hasNavigationBar(); }
+    }
+}
