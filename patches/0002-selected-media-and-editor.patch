+// Keep each selected descriptor alive for this process. An Android media model
+// may retain its DATA string after leaving the picker, so descriptors are never reused.
+static std::mutex g_selected_mutex;
+static std::map<std::string, int> g_selected_fds;
+static NSString* jstr(JNIEnv* env, jstring s);
+
+static jstring nativeReadOnlySelectedMedia(JNIEnv* env, jclass, jstring input) {
+  @autoreleasepool {
+    if (!input) return nullptr;
+    NSString* path = jstr(env, input);
+    if (!path) return nullptr;
+    int fd = ::open(path.fileSystemRepresentation, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return nullptr;
+    struct stat status{};
+    if (fstat(fd, &status) || !S_ISREG(status.st_mode)) { close(fd); return nullptr; }
+    std::string key = std::to_string(status.st_dev) + ":" + std::to_string(status.st_ino);
+    std::lock_guard<std::mutex> lock(g_selected_mutex);
+    auto prior = g_selected_fds.find(key);
+    if (prior != g_selected_fds.end()) { close(fd); fd = prior->second; }
+    else {
+        if (g_selected_fds.size() >= 256) { close(fd); return nullptr; }
+        // Fail closed if this host does not preserve read-only access through fdescfs.
+        std::string alias = "/dev/fd/" + std::to_string(fd);
+        int writable = ::open(alias.c_str(), O_RDWR);
+        if (writable >= 0) { close(writable); close(fd); return nullptr; }
+        g_selected_fds.emplace(key, fd);
+    }
+    std::string alias = "/dev/fd/" + std::to_string(fd);
+    return env->NewStringUTF(alias.c_str());
+  }
+}
