+static jobject nativeOpenSelectedMedia(JNIEnv* env, jclass, jstring input) {
+  @autoreleasepool {
+    NSString* alias = jstr(env, input);
+    if (![alias hasPrefix:@"/dev/fd/"]) return nullptr;
+    char* end = nullptr;
+    long anchor = strtol(alias.UTF8String + 8, &end, 10);
+    if (!end || *end || anchor < 0 || anchor > INT_MAX) return nullptr;
+    std::lock_guard<std::mutex> lock(g_selected_mutex);
+    bool selected = false;
+    for (const auto& entry : g_selected_fds) if (entry.second == anchor) { selected = true; break; }
+    if (!selected) return nullptr;
+    NSString* original = mediaReadPath(alias);
+    if (!original) return nullptr;
+    int fd = ::open(original.fileSystemRepresentation, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return nullptr;
+    struct stat a{}, b{};
+    if (fstat((int)anchor, &a) || fstat(fd, &b) || a.st_dev != b.st_dev || a.st_ino != b.st_ino) { close(fd); return nullptr; }
+    jclass cls = env->FindClass("java/io/FileDescriptor");
+    jmethodID constructor = cls ? env->GetMethodID(cls, "<init>", "()V") : nullptr;
+    jfieldID field = cls ? env->GetFieldID(cls, "fd", "I") : nullptr;
+    jobject result = constructor && field ? env->NewObject(cls, constructor) : nullptr;
+    if (result) env->SetIntField(result, field, fd); else close(fd);
+    if (cls) env->DeleteLocalRef(cls);
+    return result;
+  }
+}
