+static jboolean nativeIsSelectedMediaReference(JNIEnv* env, jclass, jstring input) {
+  @autoreleasepool {
+    NSString* alias = jstr(env, input);
+    if (![alias hasPrefix:@"/dev/fd/"]) return JNI_FALSE;
+    const char* number = alias.UTF8String + 8;
+    char* end = nullptr;
+    long fd = strtol(number, &end, 10);
+    if (!number[0] || !end || *end || fd < 0 || fd > INT_MAX) return JNI_FALSE;
+    std::lock_guard<std::mutex> lock(g_selected_mutex);
+    for (const auto& entry : g_selected_fds) if (entry.second == fd) return JNI_TRUE;
+    return JNI_FALSE;
+  }
+}
