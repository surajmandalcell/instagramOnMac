+    long fd = strtol(number, &end, 10);
+    if (!number[0] || !end || *end || fd < 0 || fd > INT_MAX) return nil;
+    char original[PATH_MAX];
+    int flags = fcntl((int)fd, F_GETFL);
+    if (flags < 0 || (flags & O_ACCMODE) != O_RDONLY || fcntl((int)fd, F_GETPATH, original)) return nil;
+    return [[NSFileManager defaultManager] stringWithFileSystemRepresentation:original length:strlen(original)];
+}
