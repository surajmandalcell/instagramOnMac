+// MACAPK_EXTERNAL_TEXTURE_RUNTIME_BEGIN
+static void GuestExternalShaderSource(GLuint shader, GLsizei count,
+        const GLchar* const* strings, const GLint* lengths) {
+    if (count <= 0 || !strings) { glShaderSource(shader, count, strings, lengths); return; }
+    std::string source;
+    for (GLsizei index = 0; index < count; ++index) {
+        if (!strings[index]) { glShaderSource(shader, count, strings, lengths); return; }
+        if (lengths && lengths[index] >= 0) source.append(strings[index], static_cast<size_t>(lengths[index]));
+        else source.append(strings[index]);
+    }
+    external_texture::SetShaderSource(shader, source);
+}
+static void GuestExternalGetShaderSource(GLuint shader, GLsizei capacity, GLsizei* length, GLchar* output) {
+    std::string source;
+    if (capacity < 0 || !external_texture::OriginalSource(shader, source)) {
+        glGetShaderSource(shader, capacity, length, output); return;
+    }
+    GLsizei copied = capacity > 0 ? static_cast<GLsizei>(std::min(source.size(), static_cast<size_t>(capacity - 1))) : 0;
+    if (output && capacity > 0) { std::memcpy(output, source.data(), copied); output[copied] = 0; }
+    if (length) *length = copied;
+}
+static void GuestExternalGetShaderiv(GLuint shader, GLenum name, GLint* value) {
+    std::string source;
+    if (name == GL_SHADER_SOURCE_LENGTH && value && external_texture::OriginalSource(shader, source))
+        *value = static_cast<GLint>(source.size() + 1);
+    else glGetShaderiv(shader, name, value);
+}
+static void GuestExternalDeleteShader(GLuint shader) { external_texture::ForgetShader(shader); glDeleteShader(shader); }
+static void GuestExternalBindTexture(GLenum target, GLuint texture) { external_texture::BindTexture(target, texture); }
+static void GuestExternalTexParameteri(GLenum target, GLenum name, GLint value) { glTexParameteri(external_texture::Target(target), name, value); }
+static void GuestExternalTexParameterf(GLenum target, GLenum name, GLfloat value) { glTexParameterf(external_texture::Target(target), name, value); }
+static void GuestExternalTexParameteriv(GLenum target, GLenum name, const GLint* value) { glTexParameteriv(external_texture::Target(target), name, value); }
+static void GuestExternalTexParameterfv(GLenum target, GLenum name, const GLfloat* value) { glTexParameterfv(external_texture::Target(target), name, value); }
+static void GuestExternalGetTexParameteriv(GLenum target, GLenum name, GLint* value) { glGetTexParameteriv(external_texture::Target(target), name, value); }
+static void GuestExternalGetTexParameterfv(GLenum target, GLenum name, GLfloat* value) { glGetTexParameterfv(external_texture::Target(target), name, value); }
+static void GuestExternalGetIntegerv(GLenum name, GLint* value) { glGetIntegerv(external_texture::Binding(name), value); }
+static void GuestExternalGetFloatv(GLenum name, GLfloat* value) { glGetFloatv(external_texture::Binding(name), value); }
+static void GuestExternalGetBooleanv(GLenum name, GLboolean* value) { glGetBooleanv(external_texture::Binding(name), value); }
+static EGLBoolean GuestExternalDestroyContext(EGLDisplay display, EGLContext context) {
+    EGLBoolean result = eglDestroyContext(display, context);
+    if (result) external_texture::ForgetContext(context);
+    return result;
+}
+extern "C" void* MacapkExternalTextureProc(const char* name) {
+    if (!name) return nullptr;
+#define EXTERNAL_PROC(symbol, adapter) if (std::strcmp(name, #symbol) == 0) return reinterpret_cast<void*>(&adapter)
+    EXTERNAL_PROC(glShaderSource, GuestExternalShaderSource);
+    EXTERNAL_PROC(glGetShaderSource, GuestExternalGetShaderSource);
+    EXTERNAL_PROC(glGetShaderiv, GuestExternalGetShaderiv);
+    EXTERNAL_PROC(glDeleteShader, GuestExternalDeleteShader);
+    EXTERNAL_PROC(glBindTexture, GuestExternalBindTexture);
+    EXTERNAL_PROC(glTexParameteri, GuestExternalTexParameteri);
+    EXTERNAL_PROC(glTexParameterf, GuestExternalTexParameterf);
+    EXTERNAL_PROC(glTexParameteriv, GuestExternalTexParameteriv);
+    EXTERNAL_PROC(glTexParameterfv, GuestExternalTexParameterfv);
+    EXTERNAL_PROC(glGetTexParameteriv, GuestExternalGetTexParameteriv);
+    EXTERNAL_PROC(glGetTexParameterfv, GuestExternalGetTexParameterfv);
+    EXTERNAL_PROC(glGetIntegerv, GuestExternalGetIntegerv);
+    EXTERNAL_PROC(glGetFloatv, GuestExternalGetFloatv);
+    EXTERNAL_PROC(glGetBooleanv, GuestExternalGetBooleanv);
+    EXTERNAL_PROC(eglDestroyContext, GuestExternalDestroyContext);
+#undef EXTERNAL_PROC
+    return nullptr;
+}
+// MACAPK_EXTERNAL_TEXTURE_RUNTIME_END
+#endif
 
