+    private static final Map<View, Boolean> FAILURE_POSTED = new WeakHashMap<>();
+
+    private static Activity editorActivity;
+    private static ViewGroup editorRoot;
+    private static LinearLayout statusPanel;
+    private static Runnable timeout;
+    private static int state = IDLE;
+    private static long generation;
+    private static boolean rendererFailed;
+
+    private InstagramMediaPreparationCompat() {}
+
+    /** Called once from the root View draw path; false means the editor is still starting. */
+    public static boolean onRootDraw(View view) {
+        if (view == null || view.getRootView() != view) return true;
+        if (Looper.myLooper() != Looper.getMainLooper()) {
+            MAIN.post(() -> onRootDrawMain(view));
+            return true;
+        }
+        return onRootDrawMain(view);
+    }
+
+    /** Called by the renderer after a known media preparation failure. */
+    public static void reportFailure(View origin, String ignoredReason) {
+        if (origin == null) return;
+        synchronized (FAILURE_POSTED) {
+            if (FAILURE_POSTED.put(origin, true) != null) return;
+        }
+        boolean posted = runOnMain(() -> {
+            try {
+                Activity activity = editorForOrigin(origin);
+                if (activity == null) return;
+                selectActivity(activity);
+                rendererFailed = true;
+                if (state == FAILED) return;
+                state = FAILED;
+                cancelTimeout();
+                showPanel();
+            } finally {
+                synchronized (FAILURE_POSTED) { FAILURE_POSTED.remove(origin); }
+            }
+        });
+        if (!posted) synchronized (FAILURE_POSTED) { FAILURE_POSTED.remove(origin); }
+    }
+
+    /** Called after the selected editor SurfaceView completes its first EGL14 swap. */
+    public static void reportFramePresented(View origin) {
+        runOnMain(() -> {
+            Activity activity = editorForOrigin(origin);
+            if (activity == null) return;
+            selectActivity(activity);
+            if (state == READY || rendererFailed) return;
+            state = READY;
+            cancelTimeout();
+            removePanel();
+        });
+    }
