--- /dev/null
+++ b/runtime/src/external_texture_bridge.h
@@ -0,0 +1,109 @@
+#pragma once
+
+#include <EGL/egl.h>
+#include <GLES2/gl2.h>
+#include <cctype>
+#include <map>
+#include <mutex>
+#include <string>
+
+namespace macapk::external_texture {
+// SurfaceTexture uploads owned RGBA pixels into a 2D texture on ANGLE Metal.
+// Adapt the Android sampling interface to that representation, not to a fake image.
+inline GLenum Target(GLenum target) { return target == 0x8D65 ? GL_TEXTURE_2D : target; }
+inline GLenum Binding(GLenum name) { return name == 0x8D67 ? GL_TEXTURE_BINDING_2D : name; }
+
+inline std::string ShaderSource(const std::string& source) {
+    if (source.find("samplerExternalOES") == std::string::npos
+            && source.find("GL_OES_EGL_image_external") == std::string::npos) return source;
+    std::string result;
+    result.reserve(source.size());
+    bool block = false;
+    bool lineStart = true;
+    for (size_t i = 0; i < source.size();) {
+        if (block) {
+            if (source.compare(i, 2, "*/") == 0) { result += "*/"; i += 2; block = false; }
+            else { if (source[i] == '\n') lineStart = true; result += source[i++]; }
+            continue;
+        }
+        if (source.compare(i, 2, "/*") == 0) { result += "/*"; i += 2; block = true; continue; }
+        if (source.compare(i, 2, "//") == 0) {
+            size_t end = source.find('\n', i);
+            if (end == std::string::npos) end = source.size();
+            result.append(source, i, end - i); i = end; continue;
+        }
+        unsigned char ch = source[i];
+        if (lineStart && ch == '#') {
+            size_t end = source.find('\n', i);
+            if (end == std::string::npos) end = source.size();
+            size_t word = i + 1;
+            while (word < end && std::isspace((unsigned char)source[word])) ++word;
+            if (source.compare(word, 9, "extension") == 0
+                    && word + 9 < end && std::isspace((unsigned char)source[word + 9])) {
+                word += 9;
+                while (word < end && std::isspace((unsigned char)source[word])) ++word;
+                size_t stop = word;
+                while (stop < end && (std::isalnum((unsigned char)source[stop]) || source[stop] == '_')) ++stop;
+                std::string extension = source.substr(word, stop - word);
+                if (extension == "GL_OES_EGL_image_external" || extension == "GL_OES_EGL_image_external_essl3") {
+                    result.append(end - i, ' '); i = end; continue;
+                }
+            }
+        }
+        if (std::isalpha(ch) || ch == '_') {
+            size_t end = i + 1;
+            while (end < source.size() && (std::isalnum((unsigned char)source[end]) || source[end] == '_')) ++end;
+            std::string token = source.substr(i, end - i);
+            result += token == "samplerExternalOES" ? "sampler2D" : token;
+            i = end; lineStart = false; continue;
+        }
+        result += source[i++];
+        if (ch == '\n') lineStart = true;
+        else if (!std::isspace(ch)) lineStart = false;
+    }
+    return result;
+}
+
+using ShaderKey = std::pair<EGLContext, GLuint>;
+inline std::mutex sourceMutex;
+inline std::map<ShaderKey, std::string> originalSources;
+inline void ForgetContext(EGLContext context) {
+    std::lock_guard<std::mutex> lock(sourceMutex);
+    for (auto entry = originalSources.begin(); entry != originalSources.end();)
+        if (entry->first.first == context) entry = originalSources.erase(entry);
+        else ++entry;
+}
+inline void ForgetShader(GLuint shader) {
+    std::lock_guard<std::mutex> lock(sourceMutex);
+    originalSources.erase({eglGetCurrentContext(), shader});
+}
+inline bool OriginalSource(GLuint shader, std::string& source) {
+    std::lock_guard<std::mutex> lock(sourceMutex);
+    auto entry = originalSources.find({eglGetCurrentContext(), shader});
+    if (entry == originalSources.end()) return false;
+    source = entry->second;
+    return true;
+}
+inline void SetShaderSource(GLuint shader, const std::string& source) {
+    std::string adapted = ShaderSource(source);
+    {
+        std::lock_guard<std::mutex> lock(sourceMutex);
+        ShaderKey key{eglGetCurrentContext(), shader};
+        if (adapted == source) originalSources.erase(key);
+        else originalSources[key] = source;
+    }
+    const GLchar* text = adapted.data();
+    GLint size = static_cast<GLint>(adapted.size());
+    glShaderSource(shader, 1, &text, &size);
+}
+inline void BindTexture(GLenum target, GLuint texture) {
+    bool firstExternal = target == 0x8D65 && texture && !glIsTexture(texture);
+    glBindTexture(Target(target), texture);
+    if (firstExternal) {
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+}
+}
